[
    {
        "level": 0,
        "rows": 3,
        "cols": 3,
        "fixedGrid": [
            [{ "wallColor": "BLUE" }, { "wallColor": "BLUE" }, { "wallColor": "BLUE" }],
            [{ "wallColor": "YELLOW" }, { "wallColor": "YELLOW" }, { "wallColor": "YELLOW" }],
            [{ "wallColor": "RED" }, { "wallColor": "RED" }, { "wallColor": "RED" }]
        ],
        "steps": [
            {
                "message": "빨간색을 선택하세요",
                "highlight": { "type": "palette", "color": "RED" },
                "condition": { "type": "selectColor", "color": "RED" }
            },
            {
                "message": "빨간 벽의 양들을 드래그해서 칠하세요",
                "highlight": { "type": "cells", "cells": [[2,0],[2,1],[2,2]] },
                "condition": { "type": "paint", "cells": [[2,0],[2,1],[2,2]] }
            },
            {
                "message": "잘했어요! 나머지도 같은 방법으로 구출하세요",
                "highlight": null,
                "condition": { "type": "clear" }
            }
        ]
    },
    {
        "level": 1,
        "rows": 3,
        "cols": 3,
        "fixedGrid": [
            [{ "wallColor": "YELLOW" }, { "wallColor": "YELLOW" }, { "wallColor": "YELLOW" }],
            [{ "wallColor": "BLUE" }, { "wallColor": "BLUE" }, { "wallColor": "BLUE" }],
            [{ "wallColor": "YELLOW" }, { "wallColor": "YELLOW" }, { "wallColor": "YELLOW" }]
        ],
        "steps": [
            {
                "message": "아래 양을 없애면 위의 양이 떨어집니다! 파랑을 먼저 칠하세요",
                "highlight": { "type": "cells", "cells": [[1,0],[1,1],[1,2]] },
                "condition": { "type": "paint", "cells": [[1,0],[1,1],[1,2]] }
            },
            {
                "message": "늑대가 도착하기 전 최대한 많은 양을 칠해 구해야합니다.\n한붓그리기로 한 번에 칠하세요",
                "highlight": { "type": "cells", "cells": [[1,0],[1,1],[1,2],[2,0],[2,1],[2,2]] },
                "condition": { "type": "paint", "cells": [[1,0],[1,1],[1,2],[2,0],[2,1],[2,2]] }
            }
        ]
    },
    {
        "level": 2,
        "rows": 3,
        "cols": 3,
        "fixedGrid": [
            [{ "wallColor": "BLUE" }, { "wallColor": "BLUE" }, { "wallColor": "YELLOW" }],
            [{ "wallColor": "YELLOW" }, { "wallColor": "YELLOW" }, { "wallColor": "YELLOW" }],
            [{ "wallColor": "YELLOW" }, { "wallColor": "RED" }, { "wallColor": "YELLOW" }]
        ],
        "steps": [
            {
                "message": "한붓그리기로만 칠할 수 있습니다. 노란색으로 칠해보세요.\n이렇게 없애면 비효율적이죠",
                "highlight": { "type": "cells", "cells": [[1,0],[1,1],[1,2],[2,0],[2,2]] },
                "condition": { "type": "paint", "cells": [[1,0],[1,1],[1,2],[2,0],[2,2]] }
            },
            {
                "message": "뒤로가기 아이템으로 되돌릴 수 있어요! 사용하세요",
                "highlight": { "type": "item", "item": "undo" },
                "condition": { "type": "useItem", "item": "undo" }
            },
            {
                "message": "빨간 양을 먼저 없애보세요",
                "highlight": { "type": "cells", "cells": [[2,1]] },
                "condition": { "type": "paint", "cells": [[2,1]] }
            },
            {
                "message": "이제 한붓그리기가 가능하네요!\n모든 스테이지는 정해진 턴으로 모든 양을 구할 수 있습니다.",
                "highlight": null,
                "condition": { "type": "clear" }
            }
        ]
    },
    {
        "level": 3,
        "rows": 3,
        "cols": 3,
        "fixedGrid": [
            [{ "wallColor": "RED" }, { "wallColor": "ORANGE" }, { "wallColor": "YELLOW" }],
            [{ "wallColor": "YELLOW" }, { "wallColor": "GREEN" }, { "wallColor": "BLUE" }],
            [{ "wallColor": "BLUE" }, { "wallColor": "PURPLE" }, { "wallColor": "RED" }]
        ],
        "steps": [
            {
                "message": "주황색 = 빨강 + 노랑! 빨강을 선택하세요",
                "highlight": { "type": "palette", "color": "RED" },
                "condition": { "type": "selectColor", "color": "RED" }
            },
            {
                "message": "빨간 양과 주황 양을 함께 칠하세요",
                "highlight": { "type": "cells", "cells": [[0,0],[0,1]] },
                "condition": { "type": "paint", "cells": [[0,0],[0,1]] }
            },
            {
                "message": "이제 노랑을 선택하세요",
                "highlight": { "type": "palette", "color": "YELLOW" },
                "condition": { "type": "selectColor", "color": "YELLOW" }
            },
            {
                "message": "주황 양과 노란 양을 함께 칠하세요",
                "highlight": { "type": "cells", "cells": [[0,1],[0,2],[1,0],[1,1]] },
                "condition": { "type": "paint", "cells": [[0,1],[0,2],[1,0],[1,1]] }
            },
            {
                "message": "색 조합이 궁금하면 색상표 버튼을 눌러주세요",
                "highlight": { "type": "debug", "button": "colorGuide" },
                "condition": { "type": "openColorGuide" }
            },
            {
                "message": "색상을 선택하면 그 색상이 필요한 양들이 선글라스를 씁니다",
                "highlight": null,
                "condition": { "type": "clear" }
            }
        ]
    },
    {
        "level": 4,
        "rows": 3,
        "cols": 3,
        "fixedGrid": [
            [{ "wallColor": "RED" }, { "wallColor": "YELLOW" }, { "wallColor": "BLUE" }],
            [{ "wallColor": "RED" }, { "wallColor": "BLACK" }, { "wallColor": "BLUE" }],
            [{ "wallColor": "WHITE", "type": "dirty" }, { "wallColor": "WHITE", "type": "dirty" }, { "wallColor": "WHITE", "type": "dirty" }]
        ],
        "steps": [
            {
                "message": "검은 양은 더러워진 양이에요! 물방울을 선택하세요",
                "highlight": { "type": "palette", "color": "WASH" },
                "condition": { "type": "selectColor", "color": "WASH" }
            },
            {
                "message": "더러운 양을 드래그해서 씻어주세요",
                "highlight": { "type": "cells", "cells": [[2,0],[2,1],[2,2]] },
                "condition": { "type": "wash", "cells": [[2,0],[2,1],[2,2]] }
            },
            {
                "message": "검은 배경은 빨/노/파를 모두 섞어야해요. 더러운 양과 헷갈리지 마세요!\n물방울로 잘못 칠한 양도 하얗게 되돌릴 수 있어요.",
                "highlight": null,
                "condition": { "type": "clear" }
            }
        ]
    },
    {
        "level": 5,
        "rows": 3,
        "cols": 3,
        "fixedGrid": [
            [{ "wallColor": "RED" }, { "wallColor": "RAINBOW" }, { "wallColor": "RED" }],
            [{ "wallColor": "BLACK" }, { "wallColor": "BLUE" }, { "wallColor": "BLUE" }],
            [{ "wallColor": "YELLOW" }, { "wallColor": "BLUE" }, { "wallColor": "YELLOW" }]
        ],
        "steps": [
            {
                "message": "무지개 배경은 아무 색으로나 칠할 수 있어요! 빨강으로 칠하세요",
                "highlight": { "type": "cells", "cells": [[0,0],[0,1],[0,2]] },
                "condition": { "type": "paint", "cells": [[0,0],[0,1],[0,2]] }
            },
            {
                "message": "마스킹 테이프는 한 번 칠하는 것을 막아줘요! 아이템을 선택하세요",
                "highlight": { "type": "item", "item": "mask" },
                "condition": { "type": "selectItem", "item": "mask" }
            },
            {
                "message": "아랫줄 파랑에 사용하세요",
                "highlight": { "type": "cells", "cells": [[2,1]] },
                "condition": { "type": "useItem", "item": "mask" }
            },
            {
                "message": "노란색으로 아랫줄을 칠하세요. 테이프가 붙은 칸은 보호됩니다",
                "highlight": { "type": "cells", "cells": [[2,0],[2,1],[2,2]] },
                "condition": { "type": "paint", "cells": [[2,0],[2,1],[2,2]] }
            },
            {
                "message": "한 칸 칠하기는 양의 색을 배경색으로 바꿔줘요! 아이템을 선택하세요",
                "highlight": { "type": "item", "item": "singlePaint" },
                "condition": { "type": "selectItem", "item": "singlePaint" }
            },
            {
                "message": "검은 칸에 사용하세요",
                "highlight": { "type": "cells", "cells": [[2,0]] },
                "condition": { "type": "useItem", "item": "singlePaint" }
            },
            {
                "message": "나머지를 모두 구출하세요!",
                "highlight": null,
                "condition": { "type": "clear" }
            }
        ]
    }
]
